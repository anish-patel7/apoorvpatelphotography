# ==============================================================================
# Supabase Client Configuration (Public/Client-Safe Only)
# ==============================================================================
# Only variables prefixed with VITE_ are bundled into the client build.
# NEVER place private service keys, database passwords, or secret tokens here.
# Production values should be configured in your Vercel Project Environment Settings.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# Studio Contact Configuration (Optional)
# ==============================================================================
# International phone number for direct WhatsApp routing (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=
# Business email address for client inquiries
VITE_BUSINESS_EMAIL=contact@apoorvpatelphotography.com
# Verified production site URL for canonical tags, sitemaps, and Open Graph previews
VITE_SITE_URL=https://www.apoorvpatelphotography.com

# ==============================================================================
# NOTE ON ADMIN AUTHENTICATION:
# ==============================================================================
# In accordance with production security standards, admin passwords and
# credentials must NEVER be placed in client environment files (.env) or
# prefixed with VITE_. Server-verified authentication (Supabase Auth / SSR)
# will be connected during the database integration phase.
# Admin routes are disabled in production until then.
# ==============================================================================

# ==============================================================================
# OPTIONAL: Instagram → Reels import (server-side only, /api/instagram-sync)
# ==============================================================================
# Set these ONLY in Vercel → Project → Settings → Environment Variables.
# They must NOT start with VITE_ (that would bundle them into the public site).
# See docs/INSTAGRAM_REELS.md for how to obtain them.
# INSTAGRAM_ACCESS_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=

# ==============================================================================
# OPTIONAL: original Instagram reel covers (server-side only, /api/reel-thumbnail)
# ==============================================================================
# Without these, reels without a thumbnail get a branded poster automatically.
# INSTAGRAM_ACCESS_TOKEN (above) lets the site copy the ORIGINAL cover of reels posted by
# the studio account. Optionally, a Meta app with "oEmbed Read" can be tried as well:
# META_APP_ID=
# META_CLIENT_TOKEN=
# The function uses the signed-in admin's session (no service-role key needed) and
# reads SUPABASE_URL / SUPABASE_ANON_KEY (falls back to the VITE_ values).
# SUPABASE_ANON_KEY=

# Show the "Import from Instagram" button in Admin → Reels (only after the server-side
# Instagram variables above are configured). Not a secret.
# VITE_ENABLE_INSTAGRAM_IMPORT=true
